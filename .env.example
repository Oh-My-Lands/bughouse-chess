# Copy to `.env.local` and fill in. Nothing here is read at runtime from this
# file — it is documentation. `.env.local` is gitignored; this file is not, so
# never put a real key in it.
#
# Every section is optional and independent. With none of it set the app still
# runs: you get the replay and manual analysis features, without engine
# analysis, sign-in, sharing, or metrics.

# -----------------------------------------------------------------------------
# Engine analysis (optional) — Hivemind on RunPod serverless
# -----------------------------------------------------------------------------
# Engine analysis is opt-in. Without NEXT_PUBLIC_ENGINE_ENDPOINT the engine
# panel is not rendered at all, because a search costs GPU time and must never
# start just because a page loaded.
#
# Verify the configuration with `npm run check:engine`, which reads these three
# out of .env.local and calls the endpoint's health route.

# Where the browser sends analysis requests. Set it to the app's own proxy
# route; `/api/engine/run` then forwards to RunPod server-side, so the API key
# never reaches the client.
#
# This is a NEXT_PUBLIC_* var, so it is substituted into the bundle at compile
# time rather than read at runtime: after changing it, delete `.next` and
# rebuild, or the old value survives.
NEXT_PUBLIC_ENGINE_ENDPOINT="/api/engine"

# The RunPod serverless endpoint id, from the RunPod console.
#
# Endpoints are never renamed — a changed configuration produces a new id and
# retires the old one, so an id that worked last week can simply stop existing.
# That failure returns 404, which `npm run check:engine` reports by name.
RUNPOD_ENDPOINT_ID="your-endpoint-id"

# RunPod API key. Server-side only (no NEXT_PUBLIC_ prefix) — it spends GPU
# time, so it must never be compiled into the client bundle.
#
# A restricted (job-scoped) key only authenticates against the endpoint it was
# issued for; a full-scope account key works against any. Either way a rejected
# key returns 401.
RUNPOD_API_KEY="your-runpod-api-key"

# -----------------------------------------------------------------------------
# Firebase Admin (optional) — server-side Firestore
# -----------------------------------------------------------------------------
# Needed for shared games, username reservation, and the game-load metric.
# From Firebase Console → Project settings → Service accounts → Generate key.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"

# Keep the quotes and the literal \n escapes — the admin client converts them
# back to real newlines. A key pasted with actual line breaks will not parse.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Firebase client (optional) — auth, Firestore, analytics
# -----------------------------------------------------------------------------
# From Firebase Console → Project settings → General → Your apps → Web.
# These are public by design: access is controlled by Firestore rules and App
# Check, not by hiding them.
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Required for Analytics; created when you enable Google Analytics for the app.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Required for App Check. A reCAPTCHA v3 site key.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY="your-recaptcha-v3-site-key"

# -----------------------------------------------------------------------------
# Firebase emulators (local development only)
# -----------------------------------------------------------------------------
# Set these to point auth and Firestore at `npm run emulator:start` instead of
# the real project. Leave them unset to use the real project. `cypress.config.ts`
# hardcodes both for the test run, so you only need them for manual work against
# the emulators.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# -----------------------------------------------------------------------------
# Site metadata (optional)
# -----------------------------------------------------------------------------
# Canonical origin used for SEO metadata and absolute URLs. Falls back to
# VERCEL_URL (set automatically on Vercel), then http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://example.com"
